{
  "name": "opentake",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first screen recorder and non-destructive video editor for Chromium browsers.",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:e2e": "tsc --noEmit && vite build --mode e2e",
    "build:firefox": "tsc --noEmit && vite build --mode firefox",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "fix": "biome check --write .",
    "check:biome": "biome ci .",
    "check:extension": "bun scripts/check-extension.ts",
    "check:bundle": "bun scripts/check-bundle-budget.ts",
    "check:firefox": "bun run build:firefox && bun scripts/check-firefox.ts",
    "dead-code": "knip --include files,dependencies,unlisted,unresolved",
    "audit": "bun audit --audit-level=high",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "bun run build:e2e && playwright test",
    "check": "bun run check:biome && bun run typecheck && bun run test && bun run dead-code && bun run build && bun run check:extension && bun run check:bundle && bun run check:firefox"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "mediabunny": "^1.55.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.10",
    "@crxjs/vite-plugin": "^2.7.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.7",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "fast-check": "^4.9.0",
    "jsdom": "^30.0.1",
    "knip": "6.32.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
